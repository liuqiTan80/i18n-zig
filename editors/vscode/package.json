{
  "name": "zzc-dialect",
  "displayName": "Zig Dialect (\u4e2d\u6587)",
  "description": "\u6bcd\u8bed Zig \u65b9\u8a00\u7f16\u8bd1\u5668\uff08zzc\uff09\u7684 VS Code \u96c6\u6210\uff1a\u8bed\u6cd5\u9ad8\u4eae\u3001\u8865\u5168\u3001\u6587\u4ef6\u5173\u8054\u3001\u95ee\u9898\u5339\u914d\u3001LSP \u60ac\u505c/\u5feb\u8def\u8bca\u65ad\u3002",
  "version": "0.3.0",
  "publisher": "zzc",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:zig-dialect"
  ],
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "zzc",
      "properties": {
        "zzc.lspPath": {
          "type": "string",
          "default": "",
          "description": "\u7528\u4e8e\u8fd0\u884c zzc lsp \u7684 zzc \u53ef\u6267\u884c\u6587\u4ef6\u8def\u5f84\uff1b\u7559\u7a7a\u8868\u793a\u4f7f\u7528 PATH \u4e0a\u7684 zzc\u3002"
        },
        "zzc.lang": {
          "type": "string",
          "default": "",
          "description": "\u65b9\u8a00\u5305\u540d\uff08\u540c zzc --lang\uff0c\u5982 \u7e41\u4f53\uff09\uff1b\u7559\u7a7a\u5219\u7528\u5185\u7f6e\u9ed8\u8ba4\u5305\uff08\u4e2d\u6587\uff09\u3002\u4fee\u6539\u540e\u81ea\u52a8\u91cd\u542f\u8bed\u8a00\u670d\u52a1\u5668\u3002"
        },
        "zzc.langOverlay": {
          "type": "string",
          "default": "",
          "description": "\u7b2c\u4e09\u65b9\u5e93\u8bed\u8a00\u5305\u53e0\u52a0\u5c42\u6587\u4ef6\u8def\u5f84\uff08\u540c zzc --lang-overlay\uff1b\u5efa\u8bae\u7edd\u5bf9\u8def\u5f84\uff0c\u5982 /path/to/contrib/packs/httpz-\u4e2d\u6587.txt\uff09\uff1b\u7559\u7a7a\u5219\u4e0d\u53e0\u52a0\u3002\u4fee\u6539\u540e\u81ea\u52a8\u91cd\u542f\u8bed\u8a00\u670d\u52a1\u5668\u3002"
        }
      }
    },
    "languages": [
      {
        "id": "zig-dialect",
        "aliases": [
          "Zig Dialect",
          "zz"
        ],
        "extensions": [
          ".zz"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "zig-dialect",
        "scopeName": "source.zz",
        "path": "./syntaxes/zz.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "zig-dialect",
        "path": "./snippets/zz.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "zzc-machine",
        "owner": "zig-dialect",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^([^\\s:].*?):(\\d+):(\\d+): (\\S+): (.*)$",
          "file": 1,
          "location": 2,
          "column": 3,
          "code": 4,
          "message": 5
        },
        "severity": "error"
      }
    ]
  }
}
