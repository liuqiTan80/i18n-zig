// zzc 中文方言示例：语法全景 —— 在 demo/syntax 目录内运行 `zzc run`
常数 标准库 = 导入("std");

常数 错误集 = 错误{负数};

公开 函数 分类(值: 整数) 文本 {
    匹配 (值) {
        0 => 返回 "零",
        否则 => 返回 "非零",
    }
}

公开 函数 取非负(输入: 整数) !整数 {
    如果 (输入 < 0) 返回 错误.负数;
    返回 输入;
}

公开 函数 主函数() !void {
    变量 计: 整数 = 0;
    当 (计 < 3) {
        计 = 计 + 1;
    }

    变量 可能: ?整数 = 空值;
    可能 = 7;
    常数 显示 = 可能 或不然 42;

    标准库.打印("计数={d} 分类={s} 可选={d} 取反={d}\n", .{
        计, 分类(计), 显示, 尝试 取非负(5),
    });
}
